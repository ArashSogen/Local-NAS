# =============================================================================
# VaultStage NAS Configuration
# Copy this file to .env and customize before running `docker compose up -d`.
# =============================================================================

# HTTP server port (container listens on 3000)
PORT=3000
NODE_ENV=production

# Local staging directory (Hard Disk). Files land here first and are removed
# only after cloud upload verification succeeds.
# Docker default: /data/staging
HARD_DISK_PATH=./data/staging

# rclone remote and base path (e.g. gdrive:nas-storage, s3:my-bucket/nas, or localcloud:/data/cloud)
# Each user is isolated under <CLOUD_REMOTE>/<user_id>/...
CLOUD_REMOTE=localcloud:./data/cloud

# Path to rclone.conf (mounted as a read-only or read-write volume in Docker)
# Docker default: /config/rclone/rclone.conf
RCLONE_CONFIG_PATH=./data/rclone/rclone.conf

# SQLite database file path (or sqlite:///path/to/nas.sqlite)
# Docker default: /data/db/nas.sqlite
DATABASE_URL=./data/db/nas.sqlite

# Secret key for signing cookies and session integrity (REQUIRED in production; use >=32 random bytes)
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-strong-64-char-random-hex-secret

# Upload & quota defaults (in bytes)
# MAX_UPLOAD_SIZE: 1 GiB default (1073741824)
MAX_UPLOAD_SIZE=1073741824
# DEFAULT_USER_QUOTA: 5 GiB default (5368709120)
DEFAULT_USER_QUOTA=5368709120
# Chunk size used by resumable upload client (in bytes, default 4 MiB)
UPLOAD_CHUNK_SIZE=4194304

# Background cloud sync worker settings
SYNC_CONCURRENCY=2
SYNC_RETRY_LIMIT=3
# Base exponential backoff delay in milliseconds (retry N waits backoff * 2^(N-1))
SYNC_RETRY_BACKOFF=5000

# Initial admin bootstrap credentials (only used when no admin exists yet).
# Admin is forced to change this password on first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-admin-123

# Set to true when running behind an HTTPS reverse proxy (Caddy, Nginx, Traefik)
TRUST_PROXY=true

# Optional: Force rclone binary path (auto-detected from PATH by default)
# RCLONE_BIN=/usr/bin/rclone

# Session lifetime in hours (default 24)
SESSION_TTL_HOURS=24
